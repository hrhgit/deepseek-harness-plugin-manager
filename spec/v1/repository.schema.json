{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hrhgit/deepseek-harness-plugin-manager/spec/v1/repository.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packages": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "packages"
  ],
  "additionalProperties": false
}
